# ---------------------------------------------------------------------------
# Recomeça 50+ — variáveis de ambiente
# Copie para .env e preencha. O servidor SOBE MESMO SEM nenhuma variável:
# cada recurso degrada individualmente (banco, e-mail, uploads).
# ---------------------------------------------------------------------------

# URL pública do site (usada em e-mails e links)
APP_URL=http://localhost:3000

# Segredo das sessões (obrigatório para login funcionar).
# Gere com: openssl rand -base64 32
APP_SECRET=

# Banco Postgres. No Railway, use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# E-mail do dono: o primeiro login com este e-mail vira administrador
OWNER_EMAIL=

# E-mail transacional (Resend). Sem chave, os e-mails saem no log do servidor.
RESEND_API_KEY=
RESEND_FROM=Recomeça <ola@recomeca.ia.br>

# Uploads S3 (opcional). Sem estas variáveis, botões de anexo ficam desligados.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Porta (o Railway injeta PORT automaticamente)
PORT=3000

# Ambiente
NODE_ENV=development
